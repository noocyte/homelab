    {
      "id": 13,
      "type": "timeseries",
      "title": "Power: house, EV charging and price",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "avg_over_time({entity_id=\"power_torvmyrvegen_20\"}[$__interval]) / 1000",
          "legendFormat": "Total",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "last_over_time({entity_id=\"easee_home_49970_effekt\"}[1d])",
          "legendFormat": "EV charging",
