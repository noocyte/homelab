  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "kWh per month",
      "description": "Tibber kWh per calendar month, EV charging (Easee) split out. Gaps in the data (winter 2024/25, Feb-Mar 2026) show as low months.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d)) - ((sum(increase({entity_id=\"easee_home_49970_levetidsforbruk\"}[1d] offset -1d)) <= sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d))) default 0)",
          "legendFormat": "House",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "(sum(increase({entity_id=\"easee_home_49970_levetidsforbruk\"}[1d] offset -1d)) <= sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d)))",
          "legendFormat": "EV",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        }
      ],
      "maxDataPoints": 5000,
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "YYYY-MM",
            "useTimezone": true
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Time": {
                "operation": "groupby",
                "aggregations": []
              },
              "House": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              },
              "EV": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Time",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "House (sum)": "House",
              "EV (sum)": "EV charging"
            },
            "excludeByName": {},
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "House"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "EV charging"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "Time",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "groupWidth": 0.7,
        "barWidth": 0.9,
