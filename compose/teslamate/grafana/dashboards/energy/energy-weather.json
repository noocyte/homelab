          },
          "refId": "B",
          "expr": "sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d)) - ((sum(increase({entity_id=\"easee_home_49970_levetidsforbruk\"}[1d] offset -1d)) <= sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d))) default 0)",
          "legendFormat": "House kWh",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 6
            },
            "fillOpacity": 50,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Outdoor °C"
