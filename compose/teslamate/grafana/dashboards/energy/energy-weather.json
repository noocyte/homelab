        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "House kWh per day by outdoor temperature (last 12 months)",
      "description": "Days grouped by mean outdoor temperature (rounded to 2 °C); bar = average house kWh (excl. EV) on such days.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "round(avg_over_time({entity_id=\"utetemperatur\"}[1d] offset -1d), 2)",
          "legendFormat": "Outdoor °C",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d)) - ((sum(increase({entity_id=\"easee_home_49970_levetidsforbruk\"}[1d] offset -1d)) <= sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d))) default 0)",
          "legendFormat": "House kWh",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        }
      ],
      "maxDataPoints": 5000,
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Outdoor °C": {
                "operation": "groupby",
                "aggregations": []
              },
              "House kWh": {
                "operation": "aggregate",
                "aggregations": [
                  "mean"
                ]
              }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Outdoor °C",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Outdoor °C",
                "destinationType": "string"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "House kWh (mean)": "Avg house kWh/day"
            },
            "excludeByName": {},
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
