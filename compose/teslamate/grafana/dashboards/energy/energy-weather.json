{
  "uid": "energy-weather",
  "title": "Energy - Consumption vs weather",
  "description": "Daily consumption against outdoor temperature; EV charging split out.",
  "tags": [
    "energy",
    "home-assistant"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "energy"
      ],
      "asDropdown": false,
      "title": "Energy",
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "kWh per day (house + EV) and outdoor temperature",
      "description": "Daily kWh from Tibber, split into EV charging (Easee lifetime counter) and the rest of the house. Line: daily mean outdoor temperature. Easee data is sparse mid-2024 to mid-2025, so EV kWh can land on the wrong day there.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d)) - ((sum(increase({entity_id=\"easee_home_49970_levetidsforbruk\"}[1d] offset -1d)) <= sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d))) default 0)",
          "legendFormat": "House",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "(sum(increase({entity_id=\"easee_home_49970_levetidsforbruk\"}[1d] offset -1d)) <= sum(max_over_time({entity_id=\"accumulated_consumption_torvmyrvegen_20\"}[1d] offset -1d)))",
          "legendFormat": "EV charging",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "C",
          "expr": "avg_over_time({entity_id=\"utetemperatur\"}[1d] offset -1d)",
          "legendFormat": "Outdoor °C",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
        }
      ],
      "maxDataPoints": 5000,
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Outdoor °C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "B"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineInterpolation",
                "value": "smooth"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "House"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "EV charging"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "xychart",
      "title": "Heating curve: house kWh per day vs outdoor temperature (last 12 months)",
      "description": "One dot per day. House consumption excludes EV charging. The slope below ~12 °C is your heating.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 12
      },
      "timeFrom": "365d",
      "maxDataPoints": 5000,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "avg_over_time({entity_id=\"utetemperatur\"}[1d] offset -1d)",
          "legendFormat": "Outdoor °C",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "1d"
