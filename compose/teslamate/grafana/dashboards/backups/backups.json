            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "count(last_over_time(backup_offsite_ok[1h]) == 0) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
