## Template for secrets/komodo.env (git-ignored).
## scripts/build-ignition.sh creates secrets/komodo.env from this file and
## replaces every value marked __RANDOM__ with a random string.
## Full reference: https://github.com/moghtech/komodo/blob/main/compose/compose.env

TZ=Europe/Oslo

## DB credentials
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=__RANDOM__

#= Core =#
KOMODO_HOST=http://192.168.0.240:9120
KOMODO_TITLE=Homelab
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=__RANDOM__
KOMODO_FIRST_SERVER_NAME=docker-host
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_WEBHOOK_SECRET=__RANDOM__
KOMODO_JWT_SECRET=__RANDOM__
KOMODO_JWT_TTL="1-wk"
KOMODO_MONITORING_INTERVAL="15-sec"
## How often Core polls git for changes to Stacks / Syncs.
KOMODO_RESOURCE_POLL_INTERVAL="5-min"

#= Periphery =#
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=docker-host
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
