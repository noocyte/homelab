// Renovate (Mend-hosted GitHub app): PRs for new container images in
// compose/*/compose.yaml and komodo/compose.yaml. Merging a PR = Komodo
// deploys that stack. See README.md → "Image updates (Renovate)".
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Europe/Oslo',

  // Merging several stack PRs at once is a batch deploy (crash-looped
  // backup-scheduler once). Few open PRs, merge one at a time.
  prConcurrentLimit: 3,

  // Releases must be 14 days old. PRs only appear once that has passed
  // (no CI in this repo, so the internal check counts as the result).
  minimumReleaseAge: '14 days',
  prCreation: 'not-pending',
  internalChecksAsSuccess: true,

  customManagers: [
    {
      // compose/immich/example.env: IMMICH_VERSION=v3.4.1
      customType: 'regex',
      managerFilePatterns: ['/^compose/immich/example\\.env$/'],
      matchStrings: ['IMMICH_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'immich-app/immich',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],

  packageRules: [
    {
      // Major versions (Postgres 17 → 18, Mosquitto 1.6 → 2, ...) only after
      // approval on the Dependency Dashboard issue.
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      // Moving tags: pin to a digest, so a rebuilt/moved tag becomes a PR
      // instead of changing silently on the next `compose pull`.
      matchPackageNames: [
        'postgres',
        'rclone/rclone',
        'favonia/cloudflare-ddns',
        'ghcr.io/itskovacs/trip',
        'eclipse-mosquitto',
      ],
      pinDigests: true,
    },
    {
      // Same version, rebuilt image (e.g. postgres:17 base updates).
      matchUpdateTypes: ['digest'],
      minimumReleaseAge: '3 days',
    },
    {
      // These registries give Renovate no release dates, so the age check
      // can't work (it would hold the update forever). PRs come right away;
      // check the release date yourself before merging.
      matchPackageNames: ['ghcr.io/**', 'registry.gitlab.com/**'],
      minimumReleaseAgeBehaviour: 'timestamp-optional',
      addLabels: ['check release age'],
    },
    {
      // Docker Hub has a stray v3.0.8 tag (pushed 2023, no such release on
      // GitHub); real releases are 0.x. Without this it shows up as a major.
      matchPackageNames: ['mcuadros/ofelia'],
      allowedVersions: '<1',
    },
    {
      groupName: 'teslamate',
      matchPackageNames: ['teslamate/teslamate', 'teslamate/grafana'],
    },
    {
      groupName: 'victoriametrics',
      matchPackageNames: ['victoriametrics/victoria-metrics', 'victoriametrics/vmbackup'],
    },
    {
      // Komodo itself is not deployed by its own gitops: update by hand.
      groupName: 'komodo',
      matchPackageNames: ['ghcr.io/moghtech/komodo-core', 'ghcr.io/moghtech/komodo-periphery'],
      addLabels: ['manual deploy'],
    },
    {
      // FerretDB and its DocumentDB image must match each other and Komodo;
      // the DocumentDB tag (17-0.107.0-ferretdb-2.7.0) isn't a version
      // Renovate can follow. Update together with Komodo, by hand.
      matchPackageNames: ['ghcr.io/ferretdb/**'],
      enabled: false,
    },
    {
      // Immich pins its own valkey/postgres digests per release: those come
      // with the release's docker-compose.yml, not from Renovate.
      matchFileNames: ['compose/immich/**'],
      matchManagers: ['docker-compose'],
      enabled: false,
    },
    {
      // Immich itself: IMMICH_VERSION in example.env (customManagers above),
      // followed via GitHub releases (they have dates; -rc tags are skipped).
      // Not a Komodo stack - merging deploys nothing; upgrade VM 102 by hand.
      matchDepNames: ['immich-app/immich'],
      minimumReleaseAge: '3 days',   // fix releases often follow within a day
      addLabels: ['manual deploy'],
      prBodyNotes: [
        '**Immich is not a Komodo stack: merging deploys nothing.** Before merging, follow `compose/immich/README.md` → Upgrading: read the release notes of every version in between, diff the release\'s `docker-compose.yml` / `hwaccel.*.yml` / `example.env` against this repo and add the changes to this PR, then upgrade VM 102 with a snapshot.',
      ],
    },
    {
      // Our own images (:latest, built elsewhere).
      matchPackageNames: ['noocyte/**'],
      enabled: false,
    },
    {
      // Except saic2postgresql: versioned releases (release-please + GitHub
      // Actions in noocyte/saic2postgresql). Our own code, so no age wait.
      matchPackageNames: ['noocyte/saic2postgresql'],
      enabled: true,
      minimumReleaseAge: null,
    },
  ],
}
